/Type /StructElem
/S /H1
/T (        location / {             proxy_cache my_cache;                   # Enable caching using the defined cache             proxy_cache_valid 200 60m;              # Cache 200 OK responses for 60 minutes             proxy_cache_key "$scheme$request_uri";  # Define the cache key             proxy_pass http://backend_server;       # Forward requests to the backend server             add_header X-Cache-Status $upstream_cache_status; # Add cache status header for debugging         }  )
/E (        location / {             proxy_cache my_cache;                   # Enable caching using the defined cache             proxy_cache_valid 200 60m;              # Cache 200 OK responses for 60 minutes             proxy_cache_key "$scheme$request_uri";  # Define the cache key             proxy_pass http://backend_server;       # Forward requests to the backend server             add_header X-Cache-Status $upstream_cache_status; # Add cache status header for debugging         }  )
/Alt ()
/Pg 54 0 R
/K [2 3]
